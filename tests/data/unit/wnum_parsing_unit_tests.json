{
  "type": "test_suite",
  "test_suite": "wnum_parsing_unit_tests",
  "description": "Unit tests for WNUM parsing functions",
  "requires_mud_environment": false,
  "test_level": "unit",
  "tests": [
    {
      "name": "parse_relative_vnum",
      "test_type": "pure_function_test",
      "input": {
        "function": "parse_widevnum",
        "test_cases": [
          {"argument": "#1234", "expected_vnum": 1234, "expected_success": true},
          {"argument": "invalid", "expected_vnum": 0, "expected_success": false}
        ]
      },
      "expected_output": {
        "all_cases_pass": true
      }
    }
  ]
}