{
  "type": "test_suite",
  "test_suite": "lookup_function_unit_tests",
  "description": "Unit tests for static lookup functions in lookup.c",
  "version": "1.0",
  "requires_mud_environment": false,
  "test_level": "unit",
  "tests": [
    {
      "name": "position_lookup",
      "description": "Test position_lookup function with valid and invalid inputs",
      "test_type": "pure_function_test", 
      "input": {
        "function": "position_lookup",
        "test_cases": [
          {
            "input": "dead",
            "expected": 0
          },
          {
            "input": "mort", 
            "expected": 1
          },
          {
            "input": "incap",
            "expected": 2
          },
          {
            "input": "stun",
            "expected": 3
          },
          {
            "input": "sleep",
            "expected": 4
          },
          {
            "input": "rest",
            "expected": 5
          },
          {
            "input": "sit",
            "expected": 6
          },
          {
            "input": "fight",
            "expected": 7
          },
          {
            "input": "stand",
            "expected": 8
          },
          {
            "input": "sleeping",
            "expected": 4
          },
          {
            "input": "standing",
            "expected": 8
          },
          {
            "input": "de",
            "expected": 0
          },
          {
            "input": "invalid",
            "expected": -1
          },
          {
            "input": "",
            "expected": -1
          },
          {
            "input": "xyz",
            "expected": -1
          }
        ]
      },
      "expected_output": {
        "test_result": "success"
      }
    },
