    {
      "test_type": "gmcp_sentience_",
      "name": "gmcp_build_identity_multiclass",
      "description": "Builds Sentience.Identity JSON with multiclass character",
      "input": {
        "function": "build_identity",
        "test_cases": [
          {
            "scenario": "multiclass",
            "params": {
              "name": "Arthan",
              "race_wnum": "0:1",
              "race_name": "Human",
              "body_type": "masculine",
              "level": 30,
              "tot_level": 60,
              "title": "the Grand Wizard",
              "classes": [
                {
                  "id": "0:1",
                  "name": "Warrior",
                  "level": 30,
                  "is_primary": true
                },
                {
                  "id": "0:2",
                  "name": "Mage",
                  "level": 30,
                  "is_primary": false
                }
              ]
            },
            "expected": {
              "name": "Arthan",
              "race": "Human",
              "level": 30,
              "tot_level": 60,
              "classes": [
                {
                  "id": "0:1",
                  "name": "Warrior",
                  "level": 30,
                  "is_primary": true
                },
                {
                  "id": "0:2",
                  "name": "Mage",
                  "level": 30,
                  "is_primary": false
                }
              ]
            }
          }
        ]
      },
      "expected_result": "pass"
    },
