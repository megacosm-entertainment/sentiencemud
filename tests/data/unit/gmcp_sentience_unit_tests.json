            "expected": {
              "str": 20,
              "str_base": 18,
              "int": 18,
              "int_base": 18,
              "hitroll": 15,
              "damroll": 12,
              "wimpy": 50
            }
          }
        ]
      },
      "expected_result": "pass"
    },
