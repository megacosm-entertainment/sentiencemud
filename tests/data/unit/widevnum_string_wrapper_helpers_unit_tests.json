{
  "type": "test_suite",
  "test_suite": "widevnum_string_wrapper_helpers_unit_tests",
  "description": "Pure-function unit tests for all widevnum_string_* wrapper helpers",
  "version": "1.0",
  "requires_mud_environment": true,
  "test_level": "unit",
  "tests": [
    {
      "name": "widevnum_string_mobile_core_cases",
      "test_type": "pure_function_test",
      "input": {
        "function": "widevnum_string_mobile",
        "test_cases": [
          { "area": "Limbo", "vnum": 1, "ref_area": "Limbo", "expected": "#1" },
          { "area": "Limbo", "vnum": 1, "expected": "%AREA_UID%#1" },
          { "use_null_entity": true, "expected": "0#0" }
        ]
      },
      "expected_output": { "all_cases_pass": true }
    },
