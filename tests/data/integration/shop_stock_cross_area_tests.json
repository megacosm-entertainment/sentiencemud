{
  "test_suite": "shop_stock_cross_area_tests",
  "description": "Tests for SHOP_STOCK_DATA WNUM migration - cross-area stock",
  "version": "1.0",
  "requires_mud_environment": true,
  "dependencies": ["area_loading"],
  "tests": [
    {
      "name": "shop_stock_cross_area_object",
      "description": "Test cross-area object stock creation",
      "test_type": "shop_stock_cross_area_creation",
      "input": {
        "shopkeeper_vnum": 3020,
        "target_area_uid": 954,
        "target_entity_vnum": 10500,
        "stock_type": "object"
      }
    },
    {
      "name": "shop_stock_cross_area_pet",
      "description": "Test cross-area pet stock creation",
      "test_type": "shop_stock_cross_area_creation",
      "input": {
        "shopkeeper_vnum": 3020,
        "target_area_uid": 954,
        "target_entity_vnum": 10500,
        "stock_type": "pet"
      }
    },
    {
      "name": "shop_stock_serialization",
      "description": "Test shop stock serialization for shopkeeper",
      "test_type": "shop_stock_serialization",
      "input": {
        "shopkeeper_vnum": 3020
      }
    },
    {
      "name": "shop_stock_legacy_object",
      "description": "Test legacy bare vnum stock (NULL pArea)",
      "test_type": "shop_stock_legacy_vnum",
      "input": {
        "shopkeeper_vnum": 3020,
        "entity_vnum": 3000,
        "stock_type": "object"
      }
    },
    {
      "name": "shop_stock_legacy_pet",
      "description": "Test legacy bare vnum pet stock",
      "test_type": "shop_stock_legacy_vnum",
      "input": {
        "shopkeeper_vnum": 3020,
        "entity_vnum": 3005,
        "stock_type": "pet"
      }
    }
  ]
}
