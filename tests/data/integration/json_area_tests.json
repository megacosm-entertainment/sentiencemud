{
  "type": "test_suite",
  "test_suite": "json_area_serialization",
  "description": "JSON area serialization and cross-area exit tests",
  "version": "1.0",
  "requires_mud_environment": true,
  "dependencies": ["area_loading"],
  "timeout_seconds": 60,
  "tests": [
    {
      "name": "json_area_serialize_metadata",
      "description": "Verify area metadata serializes to JSON correctly",
      "dependencies": [],
      "test_type": "json_area_serialize_test",
      "input": {
        "area_name": "Limbo",
        "expected_fields": [
          "schema_version",
          "area.uid",
          "area.name",
          "area.filename",
          "area.vnums.min",
          "area.vnums.max"
        ]
      },
      "expected_output": {
        "has_required_fields": true,
        "valid_json": true,
        "success": true
      }
    },
    {
      "name": "json_area_rooms_serialize",
      "description": "Verify rooms serialize with exits including cross-area refs",
      "dependencies": ["json_area_serialize_metadata"],
      "test_type": "json_area_rooms_test",
      "input": {
        "area_name": "Limbo",
        "check_exit_fields": true,
        "expected_exit_fields": ["direction", "to_vnum", "to_area"]
      },
      "expected_output": {
        "rooms_serialized": true,
        "exits_have_area_uid": true,
        "success": true
      }
    },
    {
      "name": "cross_area_exit_linking",
      "description": "Verify exits between areas resolve correctly after loading",
      "dependencies": [],
      "test_type": "cross_area_exit_test",
      "input": {
        "test_cases": [
          {
            "description": "Exit from one area should link to room in another",
            "source_area": "Limbo",
            "note": "Tests that stored area_uid is used for cross-area exit resolution"
          }
        ]
      },
      "expected_output": {
        "all_exits_resolved": true,
        "cross_area_exits_work": true,
        "success": true
      }
    },
    {
      "name": "json_area_roundtrip",
      "description": "Verify area can be serialized and key data matches",
      "dependencies": ["json_area_serialize_metadata"],
      "test_type": "json_area_roundtrip_test",
      "input": {
        "area_name": "Limbo",
        "verify_fields": [
          "uid",
          "name",
          "min_vnum",
          "max_vnum",
          "room_count",
          "mobile_count",
          "object_count"
        ]
      },
      "expected_output": {
        "roundtrip_success": true,
        "data_matches": true,
        "success": true
      }
    }
  ]
}
