{
  "type": "test_suite",
  "test_suite": "trait_system",
  "description": "Trait definition system validation - definitions, lookups, and defaults",
  "version": "1.0",
  "requires_mud_environment": true,
  "dependencies": ["area_loading"],
  "timeout_seconds": 20,
  "tests": [
    {
      "name": "trait_definitions_loaded",
      "description": "Verify trait definitions have been loaded from JSON",
      "dependencies": [],
      "test_type": "trait_def_count_test",
      "input": {
        "minimum_expected": 1
      },
      "expected_output": {
        "count_positive": true
      }
    },
    {
      "name": "trait_def_lookup_by_id",
      "description": "Verify trait definition lookup by ID and name works",
      "dependencies": ["trait_definitions_loaded"],
      "test_type": "trait_def_lookup_test",
      "input": {
        "test_cases": [
          {
            "use_first_loaded": true,
            "lookup_mode": "id",
            "should_find": true,
            "description": "Lookup first loaded trait by ID"
          },
          {
            "use_first_loaded": true,
            "lookup_mode": "name",
            "should_find": true,
            "description": "Lookup first loaded trait by name"
          },
          {
            "id": "totally_nonexistent_trait_xyz",
            "lookup_mode": "id",
            "should_find": false,
            "description": "Bogus trait not found"
          },
          {
            "name": "totally_nonexistent_trait_name_xyz",
            "lookup_mode": "name",
            "should_find": false,
            "description": "Bogus trait name not found"
          }
        ]
      },
      "expected_output": {
        "all_lookups_correct": true
      }
    },
    {
      "name": "trait_def_integrity",
      "description": "Verify all loaded trait definitions have required fields",
      "dependencies": ["trait_definitions_loaded"],
      "test_type": "trait_def_integrity_test",
      "input": {},
      "expected_output": {
        "all_have_id": true,
        "all_have_name": true,
        "all_have_valid_type": true,
        "no_duplicate_ids": true
      }
    },
    {
      "name": "trait_def_type_coverage",
      "description": "Verify trait definitions cover all three types: bool, int, string",
      "dependencies": ["trait_definitions_loaded"],
      "test_type": "trait_type_coverage_test",
      "input": {
        "require_bool": true,
        "require_int": true,
        "require_string": false
      },
      "expected_output": {
        "has_boolean_traits": true,
        "has_integer_traits": true
      }
    },
    {
      "name": "trait_value_functions_validation",
      "description": "Verify trait value manipulation functions work properly",
      "dependencies": ["trait_definitions_loaded"],
      "test_type": "trait_values_check",
      "input": {
        "test_trait_set_operations": true,
        "test_trait_clear_operations": true
      },
      "expected_output": {
        "set_operations_work": true,
        "clear_operations_work": true
      }
    },
    {
      "name": "trait_race_functionality",
      "description": "Verify race trait query functions work correctly",
      "dependencies": ["trait_definitions_loaded"],
      "test_type": "trait_race_check", 
      "input": {
        "test_default_values": true,
        "test_has_trait_logic": true
      },
      "expected_output": {
        "race_queries_work": true,
        "default_handling_correct": true
      }
    }
  ]
}
