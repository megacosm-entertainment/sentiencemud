{
  "type": "test_suite",
  "test_suite": "wnum_parsing",
  "description": "Tests for WNUM parsing functionality with different area contexts",
  "version": "1.0",
  "requires_mud_environment": true,
  "dependencies": [
    "area_loading"
  ],
  "tests": [
    {
      "name": "basic_wnum_parsing_limbo",
      "description": "Test basic WNUM parsing in Limbo area context",
      "dependencies": [],
      "test_type": "wnum_parser",
      "input": {
        "area_context": "Limbo",
        "test_cases": [
          {
            "explicit_area_name": "Limbo",
            "explicit_vnum": 1,
            "description": "Explicit limbo room",
            "should_parse": true,
            "expected_vnum": 1,
            "expected_area": "Limbo"
          },
          {
            "vnum_string": "#1",
            "description": "Relative vnum in Limbo",
            "should_parse": true,
            "expected_vnum": 1,
            "expected_area": "Limbo"
          },
          {
            "vnum_string": "invalid_string",
            "description": "Invalid WNUM string",
            "should_parse": false
          }
        ]
      },
      "expected_output": {
        "parsing_success": true,
        "valid_vnums_found": true
      }
    },
    {
      "name": "advanced_wnum_parsing_bootstrap",
      "description": "Test advanced WNUM parsing in Bootstrap Reserved context",
      "dependencies": [
        "basic_wnum_parsing_limbo"
      ],
      "test_type": "wnum_parser",
      "input": {
        "area_context": "Bootstrap Reserved",
        "required": false,
        "test_cases": [
          {
            "explicit_area_name": "Bootstrap Reserved",
            "explicit_vnum": 20,
            "description": "Explicit bootstrap vnum",
            "required": false,
            "should_parse": true,
            "expected_vnum": 20,
            "expected_area": "Bootstrap Reserved"
          },
          {
            "vnum_string": "#20",
            "description": "Relative vnum in bootstrap",
            "should_parse": true,
            "expected_vnum": 20,
            "expected_area": "Bootstrap Reserved"
          },
          {
            "vnum_string": "999999",
            "description": "Out of range vnum",
            "should_parse": false
          }
        ]
      },
      "expected_output": {
        "parsing_success": true,
        "area_context_correct": true
      }
    },
    {
      "name": "cross_area_wnum_parsing",
      "description": "Test WNUM parsing across different area contexts",
      "dependencies": [
        "advanced_wnum_parsing_bootstrap"
      ],
      "test_type": "wnum_parser",
      "input": {
        "area_context": "Limbo",
        "required": false,
        "test_cases": [
          {
            "explicit_area_name": "Bootstrap Reserved",
            "explicit_vnum": 20,
            "description": "Bootstrap vnum from Limbo context",
            "required": false,
            "should_parse": true,
            "expected_vnum": 20,
            "cross_area_reference": true
          },
          {
            "vnum_string": "#1",
            "description": "Relative vnum stays in current area",
            "should_parse": true,
            "expected_vnum": 1,
            "expected_area": "Limbo"
          }
        ]
      },
      "expected_output": {
        "cross_area_parsing": true,
        "area_resolution_correct": true
      }
    }
  ]
}
