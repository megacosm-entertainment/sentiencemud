{
  "type": "test_suite",
  "test_suite": "redis_area_caching",
  "description": "Redis area caching layer tests",
  "version": "1.0",
  "requires_mud_environment": true,
  "dependencies": [
    "area_loading"
  ],
  "timeout_seconds": 30,
  "tests": [
    {
      "name": "redis_available",
      "description": "Verify Redis connection is available",
      "dependencies": [],
      "test_type": "redis_available_test",
      "input": {},
      "expected_output": {
        "redis_connected": true,
        "success": true
      }
    },
    {
      "name": "redis_area_cache_after_boot",
      "description": "Verify areas are cached in Redis after boot warming",
      "dependencies": [
        "redis_available"
      ],
      "test_type": "redis_area_cached_test",
      "input": {
        "validate_cached_json": true,
        "require_cache_hits": false,
        "min_cached_hits": 1,
        "areas_to_check": [
          {
            "name": "Limbo",
            "expected_key_pattern": "area:full:limbo"
          },
          {
            "name": "Bootstrap Reserved",
            "expected_key_pattern": "area:full:bootstrap"
          },
          {
            "name": "Blueprints Testing",
            "expected_key_pattern": "area:full:blueprints"
          }
        ]
      },
      "expected_output": {
        "areas_in_cache": true,
        "cache_contains_json": true,
        "success": true
      }
    },
    {
      "name": "redis_area_cache_format",
      "description": "Verify cached area JSON has correct structure",
      "dependencies": [
        "redis_area_cache_after_boot"
      ],
      "test_type": "redis_area_cache_format_test",
      "input": {
        "area_name": "Limbo",
        "expected_uid": 923,
        "expected_filename": "limbo.json",
        "expected_json_fields": [
          "schema_version",
          "area.uid",
          "area.name",
          "area.filename",
          "rooms"
        ]
      },
      "expected_output": {
        "valid_json": true,
        "has_required_fields": true,
        "success": true
      }
    },
    {
      "name": "redis_area_warm_queue_processed",
      "description": "Verify warm queue is processed completely",
      "dependencies": [
        "redis_available"
      ],
      "test_type": "redis_warm_queue_test",
      "input": {
        "max_wait_seconds": 120,
        "check_queue_empty": true,
        "max_queue_size": 100,
        "strict": false
      },
      "expected_output": {
        "queue_empty": true,
        "success": true
      }
    }
  ]
}
