# Clang-Tidy configuration for Sentience MUD
#
# This codebase descends from DikuMUD (1990) and uses many legacy C idioms.
# The configuration focuses on high-value bug-finding checks while suppressing
# patterns that are inherent to the codebase style (assignment-in-if, narrowing
# conversions in legacy code, etc.).
#
# Usage:
#   clang-tidy -p .build myfile.c          # Run on a single file
#   clang-tidy -p .build --fix myfile.c    # Run and auto-fix where possible
#
# Requires compile_commands.json (generated by CMake in .build/).

# Enable specific check categories, then disable noisy/inapplicable ones
Checks: >
  -*,
  bugprone-*,
  -bugprone-assignment-in-if-condition,
  -bugprone-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -bugprone-macro-parentheses,
  -bugprone-suspicious-include,
  -bugprone-reserved-identifier,
  clang-analyzer-core.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  cert-err34-c,
  cert-str34-c,
  misc-redundant-expression,
  misc-unused-parameters,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-duplicate-include,

# Treat all enabled warnings as warnings (not errors) by default
WarningsAsErrors: ''

# Only check project headers, not system/library headers
HeaderFilterRegex: '/sentience/src/.*'

CheckOptions:
  # Allow short variable names (DikuMUD convention: ch, obj, fp, etc.)
  - key: readability-identifier-length.MinimumVariableNameLength
    value: '1'
  - key: readability-identifier-length.MinimumParameterNameLength
    value: '1'
