time now = get_time();
int tm = now;

print("Now = " + now);
print("Tm = " + tm);

print("5 days = " + now.add_days(5));
print("1 month = " + now.add_months(1));

time then = "2025-03-31 00:00:00";
print("Then = " + then);
print("Then + 30 days = " + then.add_days(30));

for(int m = 1; m <= 5; m++)
	print("Then + " + m + " month = " + then.add_months(m));

print("Time = " + then.add_hours(2).add_minutes(14).add_days(3));

time future = 1000000000000;
print("Future = " + future);
print("Future + 3d2h14m = " + future.add(3,2,14));
