global area plith;		// Constant
global int vnum;
global float bar;		// Constant
global widevnum wnum;	// Constant

int x = 3;
int y;

if (x > vnum)
{
	y = x;
}
else
{
	y = 0;
}

for(int z = 0; z < x; z++)
{
	if ((z + 2) < 3)
		break;
	y = z;
}

