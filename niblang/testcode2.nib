table stat(<[sleep,prone,rest,sit,kneel,crouch,stand,hang,fight]>) positions;

stat(positions) pos = <[positions.hang]>;
switch(pos)
{
case ..prone:
	print("laying down");
	break;
case rest..sit:
	print("sitting down");
	break;
case kneel:
	print("kneeling");
	break;
case crouch:
	print("crouching");
	break;
case stand..:
	print("standing");
	break;
}
print("Position: " + pos);

