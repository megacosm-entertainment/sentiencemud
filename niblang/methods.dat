/*
Function Format:
FUNCTION return-type function-name([param-list]) -> internal-name;

FUNCTION return-type function-name([param-list]) {
	internal: internal-name,
	description: "description"
}

Method Format:
METHOD return-type context-type.method-name([param-list]) -> internal-name;

Field Format:
FIELD[ constant] return-type context-type.field-name -> internal-name;

Method-as-Field Format: (inherently constant return value)
FIELD METHOD return-type context-type.method-name -> internal-name;


For flags and stats, ONLY built-in named tables may be used
*/

// Functions
function constant int random_percent() -> function_random_percent;
function void print(string) -> function_print_msg;
function void reckoning(int,int) -> function_reckoning;
function constant time get_time() -> function_get_time;

// INT methods/fields
method constant int int.random() -> number_random_value;

// TIME methods/fields
method constant time time.add(int,int,int) -> time_add;
method constant time time.add_minutes(int) -> time_add_minutes;
method constant time time.add_hours(int) -> time_add_hours;
method constant time time.add_days(int) -> time_add_days;
method constant time time.add_months(int) -> time_add_months;

