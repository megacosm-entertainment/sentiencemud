global area plith;
global string name;
global int iterations;
global char pressed;

print("===================================");
print("Global Name: " + name);

if (!iterations)
{
	print("-----------------------------------");
	print("UID: " + plith.uid);
	print("Name: " + plith.name);
	print("Description: " + plith.description);
	print("Rooms: " + plith.rooms.size());
}
int mobs = 0;
foreach(rm : plith.rooms)
{
	if (!iterations)
	{
		print("  Room: " + rm.name + "(" + rm.vnum + ")");
		print("    People: " + rm.people.size());
	}

	foreach(mob : rm.people)
	{
		mobs++;
		if (!name.length && random_percent() < 10)
			name = mob.short;

		if (!iterations)
		{
			print("      Mob: " + mob.short + " - " + mob.widevnum);
			print("        Description: " + mob.description);
		}
	}
}

print("-----------------------------------");
++iterations;

print("Last Pressed was " + pressed + '\a');
pressed = '\u4E17';

return (name.length ? mobs : 0);