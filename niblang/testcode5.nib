global object sword;

print("sword.type = " + sword.type);
print("sword.flags = " + sword.flags);

sword.flags.emits_light = false;

print("sword.flags = " + sword.flags);

print("BEFORE:");
print("sword.level = " + sword.level);
print("sword.condition = " + sword.condition);

sword.level = 123;

print("AFTER:");
print("sword.level = " + sword.level);
print("sword.condition = " + sword.condition);


print("sword.carrier = " + sword.carrier.name);

object obj = sword.carrier.equipment(<[wear_loc.wielded]>);

if (obj != null)
	print(sword.carrier.short + " is using " + obj.short + ".");
else
	print(sword.carrier.short + " is using nothing at that slot.");


