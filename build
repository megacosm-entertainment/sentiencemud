#!/bin/bash
#
# build - Configure and build Sentience MUD in one step
#
# Usage: ./build [debug|release|reldeb] [clean] [gcc|clang] [coverage] [--help]
#
# Combines ./config and ./compile into a single command.
#

show_help() {
    cat << 'EOF'
Usage: ./build [OPTIONS]

Configure (if needed) and build Sentience MUD.

Build Options:
    debug, deb              Build Debug configuration (default)
    release, rel            Build Release configuration
    relwithdebinfo, reldeb  Build Release with debug info
    tests                   Enable integration test framework
    coverage                Build with coverage, run tests, generate report
    clean                   Clean before building
    reconfig                Force reconfiguration even if already configured

Compiler Options:
    gcc                     Use GCC compiler
    clang                   Use Clang compiler

Other:
    --help, -h              Show this help message

Examples:
    ./build                 # Build Debug with default compiler
    ./build release         # Build Release
    ./build tests           # Build Debug with test framework
    ./build coverage        # Build, test, and generate coverage report
    ./build gcc debug       # Build Debug with GCC
    ./build clean release   # Clean rebuild Release
    ./build reconfig gcc    # Force reconfigure with GCC, then build
    ./build tests release   # Build Release with test framework

Output locations:
    Debug:          .build/Debug/sent
    Release:        .build/Release/sent
    RelWithDebInfo: .build/RelWithDebInfo/sent

To install the binary to /sentience:
    ./install [debug|release|reldeb]

Alternative: Use Makefile for direct GCC builds:
    make            # Build with GCC (outputs to ./sent)
    make clean      # Clean build
EOF
    exit 0
}

compiler=""
clean_opt=""
build_cfg="--config Debug"
config_name="Debug"
force_reconfig=false
build_tests=""
enable_coverage=""
do_coverage=false

for arg in "$@"
do
    if [[ ${arg,,} == "gcc" ]]; then
        compiler="-DCMAKE_CXX_COMPILER=g++ -DCMAKE_C_COMPILER=gcc"
    elif [[ ${arg,,} == "clang" ]]; then
        compiler="-DCMAKE_CXX_COMPILER=clang++ -DCMAKE_C_COMPILER=clang"
    elif [[ ${arg,,} == "clean" ]]; then
        clean_opt="--clean-first"
    elif [[ ${arg,,} == "reconfig" ]]; then
        force_reconfig=true
    elif [[ ${arg,,} == "release" ]] || [[ ${arg,,} == "rel" ]]; then
        build_cfg="--config Release"
        config_name="Release"
    elif [[ ${arg,,} == "debug" ]] || [[ ${arg,,} == "deb" ]]; then
        build_cfg="--config Debug"
        config_name="Debug"
    elif [[ ${arg,,} == "relwithdebinfo" ]] || [[ ${arg,,} == "relwithdeb" ]] || [[ ${arg,,} == "reldeb" ]]; then
        build_cfg="--config RelWithDebInfo"
        config_name="RelWithDebInfo"
    elif [[ ${arg,,} == "tests" ]]; then
        build_tests="-DBUILD_TESTS=ON"
    elif [[ ${arg,,} == "coverage" ]]; then
        do_coverage=true
        enable_coverage="-DENABLE_COVERAGE=ON"
        build_tests="-DBUILD_TESTS=ON"
        build_cfg="--config Debug"
        config_name="Debug"
    elif [[ ${arg,,} == "--help" ]] || [[ ${arg,,} == "-h" ]]; then
        show_help
    else
        echo "Unknown argument '${arg}'."
        echo "Use --help for usage information."
        exit 1
    fi
done

# Check if we need to configure
needs_config=false
if [[ ! -d ".build" ]] || [[ ! -f ".build/build.ninja" ]]; then
    needs_config=true
fi
if [[ "$force_reconfig" == true ]]; then
    needs_config=true
fi
if [[ -n "$compiler" ]] && [[ -f ".build/build.ninja" ]]; then
    # Compiler specified but already configured - need to reconfigure
    needs_config=true
fi
if [[ -n "$enable_coverage" ]] && [[ -f ".build/build.ninja" ]]; then
    # Coverage specified but already configured - need to reconfigure
    needs_config=true
fi

# Configure if needed
if [[ "$needs_config" == true ]]; then
    echo "Configuring CMake build..."
    mkdir -p .build
    rm -rf .build/*
    cmake -G "Ninja Multi-Config" -B .build . $compiler $build_tests $enable_coverage

    if [[ $? -ne 0 ]]; then
        echo ""
        echo "Configuration failed."
        exit 1
    fi
    echo ""
fi

# Build
echo "Building ${config_name}..."
cmake --build .build $clean_opt $build_cfg

if [[ $? -ne 0 ]]; then
    echo ""
    echo "Build failed."
    exit 1
fi

echo ""
echo "Build complete: .build/${config_name}/sent"

# Coverage pipeline: run tests and generate report
if [[ "$do_coverage" == true ]]; then
    echo ""
    echo "=== Coverage Analysis ==="
    echo ""

    # Check for required tools
    if ! command -v lcov &> /dev/null; then
        echo "Error: lcov not found. Install it with: sudo dnf install lcov"
        exit 1
    fi
    if ! command -v genhtml &> /dev/null; then
        echo "Error: genhtml not found. Install it with: sudo dnf install lcov"
        exit 1
    fi

    # Clear stale coverage data
    echo "Clearing old coverage data..."
    find .build -name '*.gcda' -delete 2>/dev/null

    # Run tests using the binary we just built (must run from /sentience for data paths)
    echo "Running tests..."
    pushd /sentience > /dev/null
    ./src/.build/${config_name}/sent -test
    test_exit=$?
    popd > /dev/null

    if [[ $test_exit -ne 0 ]]; then
        echo ""
        echo "Warning: Tests exited with code ${test_exit}."
        echo "Generating coverage report from available data..."
    fi

    # Capture coverage data
    echo "Capturing coverage data..."
    lcov --capture \
        --directory .build \
        --output-file .build/coverage.info \
        --ignore-errors mismatch \
        --quiet

    if [[ $? -ne 0 ]]; then
        echo "Error: lcov capture failed."
        exit 1
    fi

    # Filter out external code and test framework
    echo "Filtering coverage data..."
    lcov --remove .build/coverage.info \
        '*/.deps/*' \
        '*/tests/*' \
        '/usr/*' \
        --output-file .build/coverage_filtered.info \
        --quiet

    # Generate HTML report
    echo "Generating HTML report..."
    genhtml .build/coverage_filtered.info \
        --output-directory .build/coverage_html \
        --title "Sentience MUD Coverage" \
        --quiet

    # Print summary
    echo ""
    echo "=== Coverage Summary ==="
    lcov --summary .build/coverage_filtered.info 2>&1
    echo ""
    echo "HTML report: .build/coverage_html/index.html"
    echo "Raw data:    .build/coverage_filtered.info"
else
    echo ""
    echo "To install to /sentience:"
    echo "  ./install ${config_name,,}"
fi
