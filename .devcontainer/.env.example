# Secrets are managed via Doppler — do not create a local .env file.
#
# Usage:
#   doppler run -- docker compose up -d
#   doppler run -- docker compose --profile proxy up -d
#   doppler run -- docker compose --profile opensearch up -d
#
# To configure Doppler for this project:
#   doppler login
#   doppler setup
#
# To add a new secret:
#   doppler secrets set SECRET_NAME
#
# To verify all required secrets are present:
#   doppler secrets --only-names
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED DOPPLER SECRETS
# ─────────────────────────────────────────────────────────────────────────────
#
# ── Postgres ───────────────────────────────────────────────────────────────
# POSTGRES_USER             Superuser login for all postgres databases
# POSTGRES_PASSWORD         Superuser password
# POSTGRES_DB               Default database name (e.g. sentience)
# POSTGRES_DATA_PATH        Host path for postgres data — initialised by Postgres on first boot
#                           e.g. /localdata/docker/sentience/v2/postgres
#
# ── Payload CMS ────────────────────────────────────────────────────────────
# PAYLOAD_DB_NAME           Postgres database name for Payload (e.g. payload)
# PAYLOAD_DATABASE_URI      Full postgres connection URI used by Payload
#                           e.g. postgresql://user:pass@postgres:5432/payload
# PAYLOAD_SECRET            JWT signing secret (32+ chars)
# PAYLOAD_PUBLIC_URL        Public URL for Payload (e.g. https://cms.yourdomain.com)
# PAYLOAD_APP_PATH          Host path for Payload app — populated from the payload_dev image on first boot
#                           e.g. /localdata/docker/sentience/v2/cms
# PAYLOAD_VIRTUAL_HOST      nginx virtual host for Payload
# PAYLOAD_LETSENCRYPT_HOST  Let's Encrypt hostname for Payload TLS
#
# ── Logto ──────────────────────────────────────────────────────────────────
# LOGTO_DB_NAME             Postgres database name for Logto (e.g. logto)
# LOGTO_DATA_PATH           Host path for Logto data files (if any — Logto state is
#                           primarily in Postgres; mount only if Logto writes local files)
#                           e.g. /localdata/docker/sentience/v2/logto
# LOGTO_ENDPOINT            Public Logto endpoint (e.g. https://auth.yourdomain.com)
# LOGTO_ADMIN_ENDPOINT      Admin endpoint (e.g. https://auth.yourdomain.com/admin)
# LOGTO_VIRTUAL_HOST        nginx-proxy virtual host for Logto (port 3001; admin at /console)
# LOGTO_ADMIN_VIRTUAL_HOST  (unused — admin console is served on LOGTO_VIRTUAL_HOST/console)
# LOGTO_LETSENCRYPT_HOST    Let's Encrypt hostname for Logto TLS
# LOGTO_ADMIN_LETSENCRYPT_HOST  (unused — same cert as LOGTO_LETSENCRYPT_HOST)
#
# ── MongoDB (NodeBB) ───────────────────────────────────────────────────────
# MONGO_USER                MongoDB root username
# MONGO_PASSWORD            MongoDB root password
# MONGO_DB_NAME             Default database name (e.g. nodebb)
# MONGODB_DATA_PATH         Host path for MongoDB data — initialised by MongoDB on first boot
#                           e.g. /localdata/docker/sentience/v2/mongo
#
# ── NodeBB ─────────────────────────────────────────────────────────────────
# NODEBB_DB_NAME            MongoDB database name for NodeBB (e.g. nodebb)
# NODEBB_URL                Public URL for NodeBB (e.g. https://forum.yourdomain.com)
# NODEBB_ADMIN_USERNAME     Admin account username (used on first-run auto-install) [ADD TO DOPPLER]
# NODEBB_ADMIN_EMAIL        Admin account email    (used on first-run auto-install) [ADD TO DOPPLER]
# NODEBB_ADMIN_PASSWORD     Admin account password (used on first-run auto-install) [ADD TO DOPPLER]
# NODEBB_APP_PATH           Host path for NodeBB app — populated from image on first boot
#                           e.g. /localdata/docker/sentience/v2/forum
# NODEBB_UPLOADS_PATH       Host path for NodeBB uploads — NodeBB creates structure on first boot
#                           e.g. /localdata/docker/sentience/v2/forum_uploads
# NODEBB_VIRTUAL_HOST       nginx virtual host for NodeBB
# NODEBB_LETSENCRYPT_HOST   Let's Encrypt hostname for NodeBB TLS
#
# ── Redis ──────────────────────────────────────────────────────────────────
# REDIS_PASSWORD            Redis AUTH password (required; disable by omitting requirepass)
# REDIS_DATA_PATH           Host path for Redis data — initialised by Redis on first boot
#                           e.g. /localdata/docker/sentience/v2/redis
#
# ── OpenSearch ─────────────────────────────────────────────────────────────
# OPENSEARCH_DATA_PATH      Host path for OpenSearch data — initialised by OpenSearch on first boot
#                           e.g. /localdata/docker/sentience/v2/opensearch
#                           NOTE: directory must be writable by UID 1000 (opensearch user).
#                           On Linux: sudo chown -R 1000:1000 $OPENSEARCH_DATA_PATH
#                           [ADD TO DOPPLER — not yet in secrets list]
#
# ── Game server (Sentience MUD) ────────────────────────────────────────────
# SENTIENCE_REDIS_HOST      Redis host visible to the game server
# SENTIENCE_REDIS_PASSWORD  Redis password for the game server connection
# SENTIENCE_EMAIL_HOST      SMTP host for in-game email
# SENTIENCE_EMAIL_PORT      SMTP port
# SENTIENCE_EMAIL_USERNAME  SMTP username
# SENTIENCE_EMAIL_PASSWORD  SMTP password
# SENTIENCE_EMAIL_FROM_ADDR Sender address for outbound email
# SENTIENCE_EMAIL_FROM_NAME Sender display name
# SENTIENCE_CRYPTO_KEY_PASSPHRASE  Passphrase for player data encryption key
# SENTIENCE_CRYPTO_USE_PASSPHRASE  "true" to enable encryption passphrase
# SENTIENCE_SSL_CERT_DATA   PEM-encoded TLS certificate (base64 or raw)
# SENTIENCE_SSL_KEY_DATA    PEM-encoded TLS private key (base64 or raw)
#
# ── nginx-proxy / Certificates ─────────────────────────────────────────────
# CERT_NAME                 Shared Let's Encrypt certificate name
# LETSENCRYPT_EMAIL         Email for Let's Encrypt registration (shared across all services)
#
# Each web-accessible service uses these env vars (set per-service in Doppler):
#   VIRTUAL_HOST            Hostname(s) nginx-proxy listens on (comma-separated)
#   VIRTUAL_PORT            Container port nginx-proxy forwards 443 to
#   LETSENCRYPT_HOST        Hostname(s) for which acme-companion issues TLS certs
#   LETSENCRYPT_EMAIL       Shared — set once above, referenced by all services
#
# Services and their Doppler vars:
#   payload          → PAYLOAD_VIRTUAL_HOST / PAYLOAD_LETSENCRYPT_HOST / port 3000
#   logto            → LOGTO_VIRTUAL_HOST / LOGTO_LETSENCRYPT_HOST / port 3001 (admin at /console)
#   nodebb           → NODEBB_VIRTUAL_HOST / NODEBB_LETSENCRYPT_HOST / port 4567
#
# ── Devcontainer ───────────────────────────────────────────────────────────
# DOPPLER_TOKEN             Service token injected by devcontainer remoteEnv;
#                           set DOPPLER_TOKEN in your local shell/VSCode before opening.
#
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL SHELL VARIABLES (not secrets — set in your shell before running doppler)
# ─────────────────────────────────────────────────────────────────────────────
#
# SELINUX_LABEL   Podman + SELinux only. Set to ":z" to relabel bind-mount volumes.
#                 Example: export SELINUX_LABEL=:z
#                 Leave unset on Docker Desktop, Docker Engine (non-SELinux), or Podman without SELinux.
