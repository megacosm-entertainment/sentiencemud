# Secrets are managed via Doppler — do not create a local .env file.
#
# Required Doppler secrets for docker compose:
#
#   doppler run -- docker compose up
#   doppler run -- docker compose up --profile proxy
#
# ── Postgres ───────────────────────────────────────────────────────────────
# POSTGRES_USER
# POSTGRES_PASSWORD
#
# ── MongoDB (NodeBB) ───────────────────────────────────────────────────────
# MONGO_USER
# MONGO_PASSWORD
#
# ── Redis ──────────────────────────────────────────────────────────────────
# REDIS_PASSWORD
#
# ── Payload CMS ────────────────────────────────────────────────────────────
# PAYLOAD_SECRET        (32+ chars)
# PUBLIC_URL            (e.g. https://yourdomain.com)
#
# ── Logto ──────────────────────────────────────────────────────────────────
# LOGTO_ENDPOINT        (e.g. https://auth.yourdomain.com)
# LOGTO_ADMIN_ENDPOINT  (e.g. https://auth.yourdomain.com/admin)
#
# ── Game server ────────────────────────────────────────────────────────────
# DOPPLER_TOKEN         (already injected by devcontainer remoteEnv)
#
# To add a secret:
#   doppler secrets set SECRET_NAME
#
# To verify all required secrets are present:
#   doppler secrets --only-names
