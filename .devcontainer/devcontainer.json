{
    "image": "ghcr.io/megacosm-entertainment/sentience_trixie:latest",
    "forwardPorts": [9999],
    "mounts": ["source=${localWorkspaceFolder}/../,target=/sentience/,type=bind", "source=${localEnv:HOME}/.gnupg,target=/home/sentiencemud/.gnupg,type=bind,consistency=cached", "source=${localEnv:HOME}/.ssh/github,target=/home/sentiencemud/.ssh/github,type=bind"],
    "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
    "workspaceMount": "source=${localWorkspaceFolder},target=/sentience/src,type=bind",
    "workspaceFolder": "/sentience/src"
}