{
    "name": "Sentience MUD Dev Environment",
    "image": "ghcr.io/megacosm-entertainment/sentience_trixie:latest",
    "remoteUser": "sentiencemud",
    "workspaceFolder": "/sentience/src",
    "workspaceMount": "source=${localWorkspaceFolder},target=/sentience/src,type=bind",
    "mounts": [
        "source=${localWorkspaceFolder}/../,target=/sentience/,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gnupg,target=/home/sentiencemud/.gnupg,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/sentiencemud/.ssh,type=bind"
    ],
    "forwardPorts": [9000, 9010, 9020],
    "portsAttributes": {
        "9000": { "label": "Telnet" },
        "9010": { "label": "TLS" },
        "9020": { "label": "WebSocket" }
    },
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--userns=keep-id"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "cweijan.vscode-redis-client",
                "eamodio.gitlens",
                "Doppler.doppler-vscode"
            ],
            "settings": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "[c]": { "editor.tabSize": 4 }
            }
        }
    },
    "remoteEnv": {
        "DOPPLER_TOKEN": "${localEnv:DOPPLER_TOKEN}"
    },
    "postCreateCommand": "cd /sentience/src/.deps && ./build_deps.sh"
}